Align SM90 backward head strides in flash-attn-4 4.0.0b37.
Keep the upstream 64-element alignment for swapped dK/dV MMA layouts;
otherwise match the 32-element accumulator allocation and dQ postprocess.
Without this, head72 writes an 80-wide layout that postprocess reads as 96-wide.

--- a/flash_attn/cute/flash_bwd_sm90.py
+++ b/flash_attn/cute/flash_bwd_sm90.py
@@ -78,7 +78,7 @@
     ):
         self.dtype = dtype
         # Swapped dK/dV accumulators put head_dim on WGMMA's 64-row M axis.
-        hdim_multiple_of = 64 if dKV_swapAB else 16
+        hdim_multiple_of = 64 if dKV_swapAB else 32
         self.tile_hdim = int(math.ceil(head_dim / hdim_multiple_of) * hdim_multiple_of)
         head_dim_v = head_dim_v if head_dim_v is not None else head_dim
         self.same_hdim_kv = head_dim == head_dim_v
